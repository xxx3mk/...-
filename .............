        local Accent = Instance.new("Frame")
        Accent.Size = UDim2.new(0, 4, 1, -20)
        Accent.Position = UDim2.new(0, 0, 0, 10)
        Accent.BackgroundColor3 = notifData.isPrivate and Color3.fromRGB(255, 69, 0) or Color3.fromRGB(255, 50, 50)
        Accent.BorderSizePixel = 0
        Accent.Parent = Frame
        Instance.new("UICorner", Accent).CornerRadius = UDim.new(0, 4)
        local Avatar = Instance.new("ImageLabel")
        Avatar.Size = UDim2.new(0, 36, 0, 36)
        Avatar.Position = UDim2.new(0, 12, 0.5, -18)
        Avatar.BackgroundTransparency = 1
        Avatar.ZIndex = 102
        Avatar.Parent = Frame
        Instance.new("UICorner", Avatar).CornerRadius = UDim.new(1, 0)
        if notifData.isBot then
            Avatar.Image = "rbxassetid://112607146459388"
        else
            Avatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. notifData.senderId .. "&w=420&h=420"
        end
        local nameDisplay = notifData.displayName
        if notifData.isPrivate then nameDisplay = "(PRVT) " .. nameDisplay end
        local NameLbl = Instance.new("TextLabel")
        NameLbl.Size = UDim2.new(1, -60, 0, 20)
        NameLbl.Position = UDim2.new(0, 55, 0, 10)
        NameLbl.BackgroundTransparency = 1
        NameLbl.Text = nameDisplay
        NameLbl.TextColor3 = notifData.isPrivate and Color3.fromRGB(255, 120, 120) or Color3.fromRGB(255, 255, 255)
        NameLbl.Font = Enum.Font.GothamBold
        NameLbl.TextSize = 14
        NameLbl.TextXAlignment = Enum.TextXAlignment.Left
        NameLbl.TextTruncate = Enum.TextTruncate.AtEnd
        NameLbl.ZIndex = 102
        NameLbl.Parent = Frame
        local ContentObj = Instance.new("TextLabel")
        ContentObj.Size = UDim2.new(1, -60, 0, 25)
        ContentObj.Position = UDim2.new(0, 55, 0, 30)
        ContentObj.BackgroundTransparency = 1
        ContentObj.Text = notifData.text
        ContentObj.TextColor3 = Color3.fromRGB(200, 200, 200)
        ContentObj.Font = Enum.Font.GothamMedium
        ContentObj.TextSize = 12
        ContentObj.TextXAlignment = Enum.TextXAlignment.Left
        ContentObj.TextWrapped = true
        ContentObj.TextTruncate = Enum.TextTruncate.AtEnd
        ContentObj.ZIndex = 102
        ContentObj.Parent = Frame
        Frame.Position = UDim2.new(0, -50, 0, 0)
        Frame.BackgroundTransparency = 1
        NameLbl.TextTransparency = 1
        Avatar.ImageTransparency = 1
        Accent.BackgroundTransparency = 1
        ContentObj.TextTransparency = 1
        local enterInfo = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        ts:Create(Frame, enterInfo, {Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0.1}):Play()
        ts:Create(NameLbl, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
        ts:Create(Avatar, TweenInfo.new(0.3), {ImageTransparency = 0}):Play()
        ts:Create(Accent, TweenInfo.new(0.3), {BackgroundTransparency = 0}):Play()
        ts:Create(ContentObj, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
        task.delay(2.5, function()
            if Frame and Frame.Parent then
                local exitInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                ts:Create(Frame, exitInfo, {Position = UDim2.new(0, -50, 0, 0), BackgroundTransparency = 1}):Play()
                ts:Create(NameLbl, exitInfo, {TextTransparency = 1}):Play()
                ts:Create(Avatar, exitInfo, {ImageTransparency = 1}):Play()
                ts:Create(Accent, exitInfo, {BackgroundTransparency = 1}):Play()
                ts:Create(ContentObj, exitInfo, {TextTransparency = 1}):Play()
                task.delay(0.35, function() if Frame then Frame:Destroy() end end)
            end
        end)
        task.wait(0.3)
    end
    isProcessingNotifs = false
end

function createSideNotification(senderName, text, senderId, isPrivate, isBot)
    local displayName = getChatDisplayName(senderName)
    local isSticker = string.sub(text, 1, 8) == "rbxthumb" or string.sub(text, 1, 4) == "http"
    local displayText = isSticker and "📸 Sticker" or text
    table.insert(notificationQueue, { displayName = displayName, text = displayText, senderId = senderId, isPrivate = isPrivate, isBot = isBot or false })
    processNotificationQueue()
end

local function showBubbleChat(senderName, text)
    local isSticker = string.sub(text, 1, 8) == "rbxthumb" or string.sub(text, 1, 4) == "http"
    if isSticker then return end
    local targetPlayer = Players:FindFirstChild(senderName)
    if not targetPlayer then return end
    local character = targetPlayer.Character
    if not character then return end
    local head = character:FindFirstChild("Head")
    if not head then return end
    pcall(function() ChatService:Chat(head, text, Enum.ChatColor.White) end)
end

